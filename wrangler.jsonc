{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wc-meter-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true },

  // Demo: simulated charger, built-in stand-in for the operator's API. No secrets.
  "vars": {
    "MODE": "demo",
    "CHARGER_ID": "DEMO-WC3-001",
    "STATE_NAME": "demo-2",
    "TIME_ZONE": "Asia/Jerusalem"
  },
  // State lives in one Durable Object: strongly consistent, one run at a time.
  "durable_objects": { "bindings": [{ "name": "BRIDGE", "class_name": "BridgeState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BridgeState"] }]

  // Going live is a second Worker with its own storage and secrets: see docs/GO-LIVE.md.
}
